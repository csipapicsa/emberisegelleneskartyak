# Test and development tools, on top of the runtime dependencies. requirements-dev.txt is generated from
# this file; the runtime packages keep exactly the versions locked in requirements.txt:
#   pip-compile --generate-hashes --allow-unsafe requirements-dev.in
-c requirements.txt
-r requirements.in
pytest==9.2.0
pytest-asyncio==1.4.1.post1
httpx==0.28.1              # FastAPI's TestClient
pytest-cov==7.1.0          # coverage gate (settings in pyproject.toml)
playwright==1.65.0         # end-to-end tests in tests/e2e (browser: python -m playwright install chromium)
ruff==0.17.4               # lint (rules in pyproject.toml): python -m ruff check server tests scripts ml
pip-audit==2.10.1          # known vulnerabilities in the locked dependencies (CI audit job)
pip-tools==7.6.2           # pip-compile: regenerates the two lock files
