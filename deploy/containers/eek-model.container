# The model service for the computer player (ml/serve.py): scores cards for server/bot.py, for staging
# ("challenger", every nightly winner) and production ("champion", moved by hand with ml.promote).
# Runs the ML training image (it has PyTorch, the embedding models' code and FastAPI) with a different command,
# and follows its :main tag like staging does. The models come from MLflow, by alias, re-checked every
# 5 minutes; both share one embedding model and its cache.
#
# Rootless podman under the `eek` user, like eek-staging.container. Installed root-owned:
#   /etc/containers/systemd/users/<uid of eek>/eek-model.container
[Unit]
Description=Model service for the computer player (staging)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=eek-model
Image=ghcr.io/csipapicsa/eek-ml-train:main
AutoUpdate=registry
Exec=python -m ml.serve

# Staging and the production container reach it on their own networks (http://eek-model:8020; staging and
# production can't reach each other); production on the host (emberisegellenes.service, until it moves into
# its container: docs/runbooks/deploy.md) through this port on localhost only.
Network=eek-staging.network
Network=eek-prod.network
PublishPort=127.0.0.1:8020:8020

# /data holds the Hugging Face cache (the embedding model, ~470 MB, downloaded on the first start).
UserNS=keep-id:uid=10001,gid=10001
Volume=/srv/eek/model:/data:Z
# MLFLOW_TRACKING_URI (the public HTTPS address), MLFLOW_TRACKING_USERNAME=reader, MLFLOW_TRACKING_PASSWORD.
EnvironmentFile=/etc/eek/model.env
# The MLflow name resolves to this server's own public IP, and rootless networking (pasta) gives the container
# that same IP, so the connection would stay inside the container: "connection refused". host-gateway is the
# address pasta maps to the real host (169.254.1.2), where nginx answers; TLS still sees the right name.
AddHost=mlflow.emberisegelleneskartyak.hu:host-gateway
Environment=EEK_MODEL_URIS=challenger=models:/pick-model@challenger,champion=models:/pick-model@champion
Environment=EEK_MODEL_POLL_SECONDS=300
Environment=EEK_REFRESH_PERCENTILE=10

# Healthy = a model is loaded (/healthz 200). Loading takes about a minute, the first start longer.
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/healthz', timeout=4)"
HealthInterval=30s
HealthStartPeriod=300s
Notify=healthy
HealthOnFailure=kill
# The app's output in the system journal (journalctl CONTAINER_NAME=eek-model), not only in podman logs.
LogDriver=journald

# About 1.3 GB in use (PyTorch, the model, the embedding model and its cache); the cap keeps a leak from
# taking the server's memory.
PodmanArgs=--memory=2g
DropCapability=all
NoNewPrivileges=true
ReadOnly=true

[Service]
Restart=always
# The first start pulls the image (~1.9 GB) and downloads the embedding model.
TimeoutStartSec=900

[Install]
WantedBy=default.target
