        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Computer player decisions",
      "description": "Per 15 minutes. 'random' = the model service didn't answer in time.",
      "datasource": {
        "type": "prometheus",
        "uid": "server-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
