        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "server-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(eek_model_request_duration_seconds_bucket{env=\"$env\"}[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "server-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eek_model_request_duration_seconds_bucket{env=\"$env\"}[15m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
