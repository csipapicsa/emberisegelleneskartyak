# Copy this file to /etc/emberisegellenes/privacy.env on the server.
# Generate a long random value, for example:
#   openssl rand -hex 32
# Never commit the real value.
EEK_PRIVACY_HMAC_SECRET=replace-with-a-long-random-secret

# Password for /admin/stats (HTTP Basic Auth, any username; the page is disabled while this is unset).
# Generate with: openssl rand -hex 16
EEK_ADMIN_STATS_KEY=replace-with-a-random-key

# Shared secret with coturn (static-auth-secret) for voice chat; must match the TURN server's config.
# Keep it here, not in the unit file: unit files are readable by every user on the host.
TURN_SECRET=
