# /etc/eek/mlflow.env (root:eek 0640), read by deploy/containers/eek-mlflow.container.
# Generate both with:  openssl rand -base64 24

# Password of the `admin` user. Read only on the very first start, when MLflow creates its user database;
# change it later through the API (deploy/containers/README.md). At least 12 characters.
MLFLOW_AUTH_ADMIN_PASSWORD=

# Signs the login form's CSRF token. Must stay the same across restarts.
MLFLOW_FLASK_SERVER_SECRET_KEY=
