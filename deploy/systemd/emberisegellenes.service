[Unit]
Description=Emberisegellenes Kartyak FastAPI app
After=network.target

[Service]
Type=simple
User=adminuser_developer
WorkingDirectory=/opt/emberisegellenes_kartyak
ExecStart=/opt/emberisegellenes_kartyak/venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
